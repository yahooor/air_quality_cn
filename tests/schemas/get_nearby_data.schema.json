{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "air-quality.com data/get_nearby_data contract",
  "type": "object",
  "required": ["success", "data"],
  "additionalProperties": true,
  "properties": {
    "success": {"type": "boolean", "const": true},
    "data": {
      "type": "object",
      "required": ["nearby"],
      "additionalProperties": true,
      "properties": {
        "nearby": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["place", "latest"],
            "additionalProperties": true,
            "properties": {
              "place": {
                "type": "object",
                "required": ["place_id", "name"],
                "additionalProperties": true
              },
              "latest": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "readings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["kind"],
                      "additionalProperties": true,
                      "properties": {
                        "kind": {"type": "string"},
                        "value": {},
                        "level": {"type": ["string", "null"]}
                      }
                    }
                  },
                  "bulletins": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "type": {"type": "string"},
                        "text": {"type": ["string", "null"]},
                        "text2": {"type": ["string", "null"]}
                      }
                    }
                  },
                  "update_time": {"type": ["string", "null"]},
                  "weather": {
                    "type": ["object", "null"],
                    "additionalProperties": true
                  }
                }
              },
              "weather_forecast": {
                "type": ["object", "null"],
                "additionalProperties": true,
                "properties": {
                  "hourly": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["time"],
                      "additionalProperties": true
                    }
                  },
                  "daily": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["time", "high", "low"],
                      "additionalProperties": true,
                      "properties": {
                        "time": {"type": "string"},
                        "high": {"type": ["number", "string"]},
                        "low": {"type": ["number", "string"]},
                        "pop": {"type": ["number", "string"]},
                        "weather": {"type": ["string", "null"]},
                        "icon": {"type": ["string", "null"]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
